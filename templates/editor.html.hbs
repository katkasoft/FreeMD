<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        {{#if edit}}
            Editing article - {{title}} - FreeMD
        {{else}}
            New page - FreeMD
        {{/if}}
    </title>
    <link rel="stylesheet" href="/static/css/style.css">
    <link rel="stylesheet" href="/static/css/edit.css">
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body>
    <header>
        <div id="header-left">
            <h1 id="header-title" onclick="window.location.href = '/'">FreeMD</h1>
        </div>
        <div class="header-actions">
            <a href="/upload" class="header-btn-upload">Upload file</a>
        </div>
    </header>
    <form action="{{#if edit}}/api/edit{{else}}/api/new{{/if}}" method="POST">
        {{#if edit}}
            <input type="hidden" name="id" value="{{id}}">
        {{/if}}
        <input type="text" name="title" id="title-input" placeholder="Title" value="{{#if title}}{{title}}{{/if}}" required>
        <textarea name="content" id="content" placeholder="Content (markdown)">{{#if content}}{{content}}{{/if}}</textarea>
        <div id="preview" class="content"></div>
        {{#if is_author}}
            <div class="article-settings">
                <h3>Article Settings</h3>
                <div class="tag-container" style="margin-top: 15px; margin-bottom: 15px;">
                    <label for="tags" style="display: block; margin-bottom: 5px; font-size: 0.95rem; color: var(--text);">Tags (comma-separated)</label>
                    <input type="text" id="tags" name="tags" class="form-input" placeholder="example: rust, backend, web" style="width: 100%; padding: 10px; background: var(--bg); color: var(--text); border: 1px solid var(--border); border-radius: 6px; outline: none; font-size: 0.95rem;">
                </div>
                <label for="visibility-select">Visibility:</label>
                <select name="visibility" id="visibility-select">
                    <option value="public" {{#if (eq visibility "public")}}selected{{/if}}>Public (Everyone)</option>
                    <option value="private" {{#if (eq visibility "private")}}selected{{/if}}>Private (Only me)</option>
                    <option value="link" {{#if (eq visibility "link")}}selected{{/if}}>By secret link</option>
                </select>
                {{#if share_link}}
                    <div class="share-link-container" style="margin-top: 10px;">
                        <label>Secret link:</label>
                        <input type="text" readonly value="{{share_link}}" onclick="this.select();" style="width: 100%; padding: 5px;">
                    </div>
                {{/if}}
                <label class="checkbox-container" style="margin-top: 15px;">
                    <input type="checkbox" name="editable_for_all" id="editable-for-all" {{#if editable}}checked{{/if}}>
                    <span class="checkmark"></span>
                    Editable for all
                </label>
            </div>
        {{/if}}
        <p id="error" style="color: red;">{{ error }}</p>
        <button type="submit">Submit</button>
    </form>
    <script>
        const content = document.getElementById('content');
        const preview = document.getElementById('preview');
        preview.innerHTML = marked.parse(content.value);
        content.addEventListener('input', () => {
            preview.innerHTML = marked.parse(content.value);
        });
    </script>
</body>
</html>