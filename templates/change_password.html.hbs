<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change password - FreeMD</title>
    <link rel="stylesheet" href="/static/css/style.css">
    <link rel="stylesheet" href="/static/css/auth.css">
</head>
<body>
    <header>
        <div id="header-left">
            <h1 id="header-title" onclick="window.location.href = '/'">FreeMD</h1>
        </div>
    </header>
    <form action="/api/change-password" method="post">
        <h1>Change password</h1>
        <input type="password" name="old_password" id="old-password" class="form-input" placeholder="Old password">
        <input type="password" name="new_password" id="new-password" class="form-input" placeholder="New password">
        <input type="password" name="confirm" id="confirm" class="form-input" placeholder="Confirm new password">
        <button type="submit">Submit</button>
        {{#if error}}
            <p id="error">{{error}}</p>
        {{/if}}
    </form>
</body>
</html>