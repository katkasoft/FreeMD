<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - FreeMD</title>
    <link rel="stylesheet" href="/static/css/style.css">
    <link rel="stylesheet" href="/static/css/article.css">
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body>
    <header>
        <div id="header-left">
            <h1 id="header-title" onclick="window.location.href = '/'">FreeMD</h1>
        </div>
        <div id="header-right">
            <input type="text" id="search" placeholder="Search...">
            {{#if login}}
                <button id="new" class="header-btn" onclick="window.location.href = '/new'">+</button>
                <a href="/user/{{username}}" id="header-username">{{username}}</a>
            {{else}}
                <button id="login" class="header-btn" onclick="window.location.href = '/login'">Log in</button>
                <button id="register" class="header-btn" onclick="window.location.href = '/register'">Register</button>
            {{/if}}
        </div>
    </header>
    <div id="article">
        <div id="article-header">
            <div>
                <h1 id="title">{{ title }}</h1>
                <div class="article-meta">
                    <span>Author: <a href="/user/{{author}}" class="author-link"><strong>{{ author }}</strong></a></span>
                    <span class="article-views">{{ views }} views</span>
                    {{#if tags}}
                        <div class="article-tags">
                            {{#each tags}}
                                <a href="/tag/{{this}}" class="tag-badge">{{this}}</a>
                            {{/each}}
                        </div>
                    {{/if}}
                </div>
            </div>
            {{#if is_editable }}
                <div class="article-actions">
                    <a href="/edit?id={{id}}" id="edit-btn">Edit</a>
                    <form action="/api/delete-article" method="post" onsubmit="return confirm('Are you sure that you want delete this article? This can not be cancelled');" style="display:inline;">
                        <input type="hidden" name="id" value="{{id}}">
                        <button type="submit" id="delete-btn">Delete</button>
                    </form>
                </div>
            {{/if}}
        </div>
        <div id="content">{{ content }}</div>
        <div class="vote-section">
            <button class="vote-btn vote-up" aria-label="Upvote">▲</button>
            <span class="vote-score" id="vote-score">{{score}}</span>
            <button class="vote-btn vote-down" aria-label="Downvote">▼</button>
        </div>
        <div id="comments-section">
            <h2>Comments</h2>
            {{#if login}}
                <form action="/api/new-comment" method="POST" id="comment-form">
                    <input type="hidden" name="article_id" value="{{id}}">
                    <textarea name="content" placeholder="Write a comment..." required></textarea>
                    <p id="comment-error" style="color: var(--danger); display: none; margin: 0; font-size: 0.9rem;"></p>
                    <button type="submit">Post Comment</button>
                </form>
            {{/if}}
            <div id="comments-list">
                {{#each comments}}
                    <div class="comment">
                        <p><strong><a href="/user/{{this.author}}">{{this.author}}</a></strong> <span class="comment-date">{{this.created_at}}</span></p>
                        <p>{{this.content}}</p>
                    </div>
                {{else}}
                    <p>No comments yet..</p>
                {{/each}}
            </div>
        </div>
    </div>
    <script src="/static/js/article.js"></script>
</body>
</html>